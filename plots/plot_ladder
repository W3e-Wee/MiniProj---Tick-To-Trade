set terminal png size 900,600
set output "compiled/stageB/ladder.png"
set title "Speedup against V0 using stress with 5 repeats"
set ylabel "Speedup"
stats "compiled/stageB/ladder.dat" using 2 nooutput
set xrange [-0.6:4.6]
set yrange [0:STATS_max + 1]
set boxwidth 0.6
set style fill solid 0.8
set grid ytics
set key off
plot "compiled/stageB/ladder.dat" using 0:2:xtic(1) with boxes, \
     "" using 0:2:(sprintf("%.2fx", $2)) with labels offset 0,1