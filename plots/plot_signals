set terminal png size 1400,700
set output "compiled/signals.png"
set title "Price, short SMA (30) and long SMA (60) with BUY/SELL signals"
set xlabel "Trade number"
set ylabel "Price (USDT)"
plot "signals.dat" using 1:2 with lines title "Price", \
     "" using 1:3 with lines title "Short SMA", \
     "" using 1:4 with lines title "Long SMA", \
     "" using ($5==1 ? $1 : 1/0):2 with points pt 9 title "BUY", \
     "" using ($5==-1 ? $1 : 1/0):2 with points pt 11 title "SELL"