set terminal png size 900,600
set output "rival.png"
set title "Money lost by V0 against the rival's reaction time (stress_full.csv)"
set xlabel "Rival reaction time R (microseconds, log scale)"
set ylabel "Money lost by V0 (USDT, negative = lost)"
set logscale x
set grid
set xzeroaxis
set key off
set arrow from 1, graph 0 to 1, graph 1 nohead lc rgb "gray"
set label "standard rival R = 1 us" at 1, graph 0.95 offset 1,0
plot "rival.dat" using 1:(-$4) with linespoints pointtype 7